# 百炼模型：Key 必填；模型可按需修改
DASHSCOPE_API_KEY=
APPRAISAL_LLM_MODEL=qwen3.7-max-2026-05-17
# Optional narrative-step override; blank means use APPRAISAL_LLM_MODEL.
APPRAISAL_LLM_MODEL_NARRATIVE=

# 企查查：购买接口后填写 Key 和 SecretKey
QICHACHA_APP_KEY=
QICHACHA_SECRET_KEY=
# 留空时调用 735/231/514/233/2001/213；可显式限制补充证据接口
QICHACHA_EXTRA_API_CODES=
# 节点 2 对被评估主体自动执行：886 关键词候选 → 915 上市公告 → 699 上市公司信息/指标
# 设为 false 时跳过这条对标上市公司候选链路
QICHACHA_ENABLE_COMPARABLE_DISCOVERY=true

# PDF OCR：默认使用阿里云文档智能，不在本机加载 PaddleOCR
APPRAISAL_OCR_PROVIDER=aliyun
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
# false 为基础链路；复杂扫描件可改为 true，费用和耗时会增加
APPRAISAL_OCR_VLM=false
APPRAISAL_OCR_TIMEOUT_SECONDS=900
